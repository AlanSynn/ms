# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri build artifacts (can be regenerated)
src-tauri/target/

# Required bundle icons are source assets; keep generated extras ignored.
src-tauri/icons/*
!src-tauri/icons/icon.png
!src-tauri/icons/icon.ico
!src-tauri/icons/icon.icns

# Generated Tauri schemas
src-tauri/gen/

# Portable exe output
exe build/

# Temporary build files
app-icon.png

test-results/
playwright-report/

# Local agent/runtime state
.omx/
.omc/
.agents/
skills-lock.json

# Local secrets (study Worker admin/GH tokens, never commit)
.env
.env.*
!.env.example

# Cloudflare Workers local state (R2 blobs, sqlite, temp) — never commit
.wrangler/

# Transient debug / repro scratch at the repo root (one-off scripts, snapshot
# dumps, screenshots, stray Playwright output dirs). Anchored to root so legit
# source elsewhere is never matched. These are session artifacts, not source.
/repro*.ts
/repro*.js
/repro*.mjs
/repro*.png
/check-*.ts
/check_*.ts
/snap_*.json
/test-results-*/
tests/browser/*debug*.spec.ts
tests/browser/tmp-*.spec.ts

