# Local study-Worker secrets — copy to .env (gitignored) and fill in.
# .env is never committed; keep real values only in .env.

# Bearer token for /ms-study/v1/admin/* (replay/session retrieval).
STUDY_ADMIN_TOKEN=

# GitHub PAT used by the Worker to file bug issues (repo Issues:write on AlanSynn/ms).
# Locally: `gh auth token` works (scopes: repo). For the Worker, set as a Wrangler secret.
STUDY_GITHUB_TOKEN=

# Cloudflare account that hosts the motionsmith-study Worker.
CLOUDFLARE_ACCOUNT_ID=5af02c4a8b7da8e437893615cdb42b87

# Deployed Worker base URL.
STUDY_WORKER_URL=https://alansynn.com/ms-study/v1
