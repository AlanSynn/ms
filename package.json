{
    "name": "motionsmith-character-motion-designer",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "build:exe": "node scripts/with-rustup-cargo.mjs tauri build --bundles app",
        "test": "npm run test:contracts",
        "test:contracts": "esbuild tests/project-contract.test.ts --bundle --platform=node --format=esm --outfile=/tmp/motionsmith-contract.mjs && node /tmp/motionsmith-contract.mjs",
        "build:dmg": "node scripts/with-rustup-cargo.mjs tauri build --bundles dmg",
        "test:browser": "playwright test",
        "build:tauri-frontend": "tsc && vite build --base ./"
    },
    "dependencies": {
        "gifuct-js": "^2.1.2",
        "lucide-react": "^0.554.0",
        "onnxruntime-web": "^1.27.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "three": "^0.184.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tauri-apps/cli": "^2.9.6",
        "@types/node": "^22.14.0",
        "@vitejs/plugin-react": "^5.0.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.0"
    }
}
