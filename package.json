{
  "name": "motionsmith-character-motion-designer",
  "private": true,
  "version": "0.0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:e2e": "MOTIONSMITH_E2E_DIAGNOSTICS=1 bun run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:exe": "bun scripts/with-rustup-cargo.mjs tauri build --bundles app",
    "test": "bun run test:contracts",
    "test:contracts": "bun tests/project-contract.test.ts && bun tests/chromebook-audit-contract.test.ts",
    "test:chromebook-audit": "bun run build && env -u NO_COLOR CHROMEBOOK_AUDIT=1 PLAYWRIGHT_SERVER=preview PLAYWRIGHT_PORT=5174 playwright test tests/browser/chromebook-audit.spec.ts --workers=1",
    "test:chromebook-audit:quick": "bun run build && env -u NO_COLOR CHROMEBOOK_AUDIT=1 CHROMEBOOK_AUDIT_ENFORCE=0 CHROMEBOOK_AUDIT_PLAYBACK_MS=5000 PLAYWRIGHT_SERVER=preview PLAYWRIGHT_PORT=5174 playwright test tests/browser/chromebook-audit.spec.ts --workers=1",
    "build:dmg": "bun scripts/with-rustup-cargo.mjs tauri build --bundles dmg",
    "test:browser": "bun run build:e2e && env -u NO_COLOR PLAYWRIGHT_SERVER=preview playwright test",
    "build:tauri-frontend": "tsc && vite build --base ./"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^1.21.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
